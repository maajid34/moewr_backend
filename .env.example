# Existing application configuration. Do not copy production values into tests.
PORT=3000
# Transactions require a replica set (including a single-node replica set) or Atlas.
db_url=mongodb://127.0.0.1:27017/jubaland?replicaSet=rs0
JWT_Secret=replace-with-a-long-random-secret

# Shared image/registry S3 client. Secrets are never logged by the image helper.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_BASE=

# A PRIVATE bucket for the new registry; deliberately no public-bucket fallback.
# The shared credentials need access to this bucket. No public R2/custom-domain URL.
WATER_REGISTRY_BUCKET=

# Optional document/registry credential fallbacks when corresponding S3 values are absent:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE=
